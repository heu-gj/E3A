+    def forward(
+        self,
+        aggregated_tokens_list: list[torch.Tensor | None],
+        images: torch.Tensor,
+        patch_token_start: int,
+        frames_chunk_size: int | None = 8,
+        return_features: bool = False,
+    ) -> tuple[torch.Tensor, torch.Tensor] | tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        if patch_token_start is None:
+            raise ValueError("patch_token_start is required for DenseHead")
+
+        _, num_frames, _, _, _ = images.shape
+
+        if frames_chunk_size is None or frames_chunk_size >= num_frames:
+            return self._forward_impl(
+                aggregated_tokens_list, images, patch_token_start, return_features=return_features
+            )
+
+        assert frames_chunk_size > 0
+
+        depth_chunks = []
+        depth_conf_chunks = []
+        fused_chunks = []
+        for frames_start_idx in range(0, num_frames, frames_chunk_size):
+            frames_end_idx = min(frames_start_idx + frames_chunk_size, num_frames)
+            chunk_output = self._forward_impl(
+                aggregated_tokens_list,
+                images,
+                patch_token_start,
+                frames_start_idx,
+                frames_end_idx,
+                return_features=return_features,
+            )
+            if return_features:
+                depth_chunk, depth_conf_chunk, fused_chunk = chunk_output
+                fused_chunks.append(fused_chunk)
+            else:
+                depth_chunk, depth_conf_chunk = chunk_output
+            depth_chunks.append(depth_chunk)
+            depth_conf_chunks.append(depth_conf_chunk)
+
+        depth = torch.cat(depth_chunks, dim=1)
+        depth_conf = torch.cat(depth_conf_chunks, dim=1)
+        if return_features:
+            return depth, depth_conf, torch.cat(fused_chunks, dim=1)
+        return depth, depth_conf
 
